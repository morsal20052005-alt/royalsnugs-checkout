f="/cdn/assets/icons-c6b5375eadec3cee.svg#codex-icon-ellipsis-horizontal-light-16" fill="currentColor"></use></svg></span></button></div></div></div></div></div></div></div><div class="" style="margin-top: 12px; height: 2366px;"><div class="[&amp;_[data-virtualized-turn-content]]:[content-visibility:visible]" data-turn-key="8f9f271f-31a6-40fe-866b-26dde03400d7"><div data-content-search-turn-key="fallback-turn-61"><div class="flex flex-col gap-1.5"><div class="group flex flex-col" data-talvt-turn-state="complete"><div class="flex flex-col gap-3 browser:gap-1"><div class="block-BQZwFn"><h4 class="sr-only m-0 select-none print:not-sr-only print:mt-4 print:mb-2 print:text-xs print:leading-normal print:font-bold">You said:</h4><div class="group/user-message flex flex-col items-end gap-2" data-chatgpt-search-unit-key="fallback-turn-61:0:user" data-chatgpt-search-message-ids="8f9f271f-31a6-40fe-866b-26dde03400d7"><div class="w-full" data-content-search-unit-key="fallback-turn-61:0:user"><div class="group/user-message flex w-full flex-col gap-1 items-end"><div data-user-message-bubble="true" class="bg-user-message text-user-message min-w-0 max-w-(--user-chat-width) overflow-hidden break-words px-(--thread-content-margin) [&amp;_.contain-inline-size]:[contain:initial] bubble-vBnidZ py-2.5 rounded-2xl relative text-start"><div class="flex flex-col items-end gap-1"><div class="relative w-full min-w-0 text-size-chat leading-relaxed"><div class="overflow-hidden" data-search-result-target="" style="max-height: 19lh;"><div><div class="text-size-chat whitespace-pre-wrap" dir="auto">"use strict";

const http = require("node:http");
const crypto = require("node:crypto");

const PORT = Number(process.env.PORT || 10000);
const TOKEN = process.env.SQUARE_ACCESS_TOKEN;
const LOCATION = process.env.SQUARE_LOCATION_ID;
const MODE = process.env.SQUARE_ENVIRONMENT || "sandbox";
const STORE = (process.env.STORE_ORIGIN || "https://www.bookrobe.com").replace(/\/$/, "");

const API = MODE === "production"
  ? "https://connect.squareup.com"
  : "https://connect.squareupsandbox.com";

const ALLOWED = new Set([
  STORE,
  "https://www.bookrobe.com",
  "https://bookrobe.com",
  "https://sandbox.square.online",
  "https://square.online"
]);

const PRICES = {
  1: 14100,
  2: 23970,
  3: 35155
};

const UPSELLS = {
  skip: { name: "Skip the Line", price: 800 },
  protect: { name: "Shipping Protection", price: 800 },
  mystery: { name: "Mystery Box", price: 2200 },
  slides: { name: "Matching Slides", price: 2200 }
};

const ROBES = {
  "Fourth Wing": "Q6WXWDBK6B6BU422TKMFY27V",
  "Fourth Wing V2": "C5O6C4BB6FBDWBTNBVSEMCDB",
  "Romeo &amp; Juliet": "ODUFTATMC4TCPBKIAQX6RE47",
  "Pride &amp; Prejudice": "C3TKOLGPOIXKESIZSF2SFZ32",
  "Nocticadia": "JC6W422MMQH7B6UGUPZ7QU7H",
  "ACOTAR": "P26DAIBRRWTYPWIZGU47TARZ",
  "A Court of Thorns and Roses": "P26DAIBRRWTYPWIZGU47TARZ",
  "Throne of Glass": "NHDCCABB5PNCUZGMVF6ZFFM7",
  "Percy Jackson": "LTJIOAOJ6EWMUVGGXQJGN2L7",
  "Threshing Day": "TPYSYGCHKCKHUQ5JL4IACDLE",
  "Haunting Adeline": "FXBE5VFZCW6DTFOBI6CKHYYZ",
  "Normal Book Robe": "NUPXDJ4Y3JSLMDIHSZAQLPTR",
  "Book Robe": "NUPXDJ4Y3JSLMDIHSZAQLPTR"
};

const money = amount =&gt; ({
  amount,
  currency: "CAD"
});

function respond(res, status, data, origin = "") {
  const headers = {
    "Content-Type": "application/json",
    "Cache-Control": "no-store",
    "Vary": "Origin"
  };

  if (ALLOWED.has(origin)) {
    headers["Access-Control-Allow-Origin"] = origin;
  }

  res.writeHead(status, headers);
  res.end(JSON.stringify(data));
}

function validateCart(body) {
  const cart = Array.isArray(body.cart)
    ? body.cart
    : [body];

  if (!cart.length || cart.length &gt; 12) {
    throw new Error("Invalid cart size");
  }

  const groups = [];
  let totalBundles = 0;

  for (const entry of cart) {
    const selections = entry.selections || entry.items;
    const qty = entry.qty === undefined
      ? 1
      : Number(entry.qty);

    if (
      !Array.isArray(selections) ||
      ![1, 2, 3].includes(selections.length)
    ) {
      throw new Error("Invalid bundle selections");
    }

    if (!Number.isInteger(qty) || qty &lt; 1 || qty &gt; 10) {
      throw new Error("Invalid cart quantity");
    }

    if (
      entry.quantity !== undefined &amp;&amp;
      Number(entry.quantity) !== selections.length
    ) {
      throw new Error("Bundle quantity mismatch");
    }

    totalBundles += qty;

    const robes = selections.map(item =&gt; {
      const design = String(item.design || item.name || "");
      const size = String(item.size || "");

      if (!Object.hasOwn(ROBES, design)) {
        throw new Error("Unknown robe design");
      }

      if (![
        "XS", "S", "M", "L", "XL",
        "One Size", "One Size Fits All"
      ].includes(size)) {
        throw new Error("Invalid robe size");
      }

      return {
        design,
        size,
        catalogId: ROBES[design]
      };
    });

    const extras = entry.upsells || entry.extras || {};

    if (
      !extras ||
      typeof extras !== "object" ||
      Array.isArray(extras)
    ) {
      throw new Error("Invalid upsells");
    }

    const chosenUpsells = [];

    for (const key of Object.keys(extras)) {
      if (!Object.hasOwn(UPSELLS, key)) {
        throw new Error("Unknown upsell");
      }

      if (
        extras[key] === true ||
        extras[key]?.selected === true
      ) {
        chosenUpsells.push(key);
      }
    }

    const slideSize = String(
      entry.slideSize ||
      extras.slides?.size ||
      "Small"
    );

    if (
      chosenUpsells.includes("slides") &amp;&amp;
      !["Small", "Medium", "Large"].includes(slideSize)
    ) {
      throw new Error("Invalid slide size");
    }

    groups.push({
      robes,
      chosenUpsells,
      slideSize,
      qty
    });
  }

  if (totalBundles &gt; 20) {
    throw new Error("Invalid cart quantity");
  }

  return groups;
}

function createOrder(groups) {
  const lines = [];

  for (const group of groups) {
    const robeCount = group.robes.length;
    const bundlePrice = PRICES[robeCount];

    const each = Math.floor(bundlePrice / robeCount);
    const remainder = bundlePrice % robeCount;

    for (let repeat = 0; repeat &lt; group.qty; repeat++) {
      group.robes.forEach((robe, index) =&gt; {
        lines.push({
          name: "Bookish Heated Robe - " + robe.design,
          quantity: "1",
          base_price_money: money(
            each + (index &lt; remainder ? 1 : 0)
          ),
          note:
            "Size: " + robe.size +
            " | Catalog variation: " + robe.catalogId
        });
      });

      for (const key of group.chosenUpsells) {
        const extra = UPSELLS[key];

        lines.push({
          name: extra.name +
            (key === "slides"
              ? " - " + group.slideSize
              : ""),
          quantity: "1",
          base_price_money: money(extra.price)
        });
      }
    }
  }

  if (!lines.length || lines.length &gt; 150) {
    throw new Error("Invalid cart size");
  }

  return {
    location_id: LOCATION,
    line_items: lines
  };
}

const server = http.createServer(async (req, res) =&gt; {
  const origin = req.headers.origin || "";
  const path = new URL(
    req.url,
    "http://localhost"
  ).pathname;

  // Square preview and live website CORS.
  if (req.method === "OPTIONS") {
    if (!ALLOWED.has(origin)) {
      return respond(res, 403, {
        error: "Origin not allowed"
      });
    }

    res.writeHead(204, {
      "Access-Control-Allow-Origin": origin,
      "Access-Control-Allow-Methods": "POST, OPTIONS",
      "Access-Control-Allow-Headers": "Content-Type",
      "Access-Control-Max-Age": "600",
      "Vary": "Origin"
    });

    return res.end();
  }

  // Server health test.
  if (path === "/health" &amp;&amp; req.method === "GET") {
    return respond(res, 200, {
      ok: true,
      environment: MODE,
      cart: true
    });
  }

  // Square checkout endpoint.
  if (
    path !== "/api/bundle-checkout" ||
    req.method !== "POST"
  ) {
    return respond(res, 404, {
      error: "Not found"
    }, origin);
  }

  if (!ALLOWED.has(origin)) {
    return respond(res, 403, {
      error: "Origin not allowed"
    });
  }

  if (!TOKEN || !LOCATION) {
    return respond(res, 503, {
      error: "Square credentials missing"
    }, origin);
  }

  try {
    let raw = "";

    for await (const chunk of req) {
      raw += chunk;

      if (raw.length &gt; 20000) {
        throw new Error("Request too large");
      }
    }

    let parsed;

    try {
      parsed = JSON.parse(raw);
    } catch {
      return respond(res, 400, {
        error: "Invalid JSON"
      }, origin);
    }

    const groups = validateCart(parsed);
    const order = createOrder(groups);

    const payload = {
      idempotency_key: crypto.randomUUID(),
      order,
      checkout_options: {
        ask_for_shipping_address: true,
        redirect_url: STORE
      }
    };

    const squareResponse = await fetch(
      API + "/v2/online-checkout/payment-links",
      {
        method: "POST",
        headers: {
          "Authorization": "Bearer " + TOKEN,
          "Square-Version": "2026-09-16",
          "Content-Type": "application/json"
        },
        body: JSON.stringify(payload),
        signal: AbortSignal.timeout(20000)
      }
    );

    const result = await squareResponse.json();

    if (!squareResponse.ok) {
      console.error(
        "Square checkout error:",
        squareResponse.status,
        JSON.stringify(result.errors || [])
      );

      return respond(res, 502, {
        error: "Square checkout creation failed"
      }, origin);
    }

    const checkoutUrl = result.payment_link?.url;

    if (!checkoutUrl) {
      return respond(res, 502, {
        error: "No Square checkout URL returned"
      }, origin);
    }

    return respond(res, 200, {
      url: checkoutUrl
    }, origin);

  } catch (error) {
    if (
      /^(Invalid|Unknown|Bundle|Request too)/.test(
        error.message
      )
    ) {
      return respond(res, 400, {
        error: error.message
      }, origin);
    }

    console.error("Checkout error:", error);

    return respond(res, 500, {
      error: "Checkout unavailable"
    }, origin);
  }
});

server.listen(PORT, "0.0.0.0", () =&gt; {
  console.log(
    "Bookish Robes checkout running on port",
    PORT,
    "Mode:",
    MODE
  );
